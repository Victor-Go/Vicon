{
  "name": "vicon-avatars",
  "version": "0.1.0",
  "description": "Deterministic landscape icon generator: one string in, one of billions of tiny SVG scenes out.",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./react": {
      "import": {
        "types": "./dist/react.d.ts",
        "default": "./dist/react.js"
      },
      "require": {
        "types": "./dist/react.d.cts",
        "default": "./dist/react.cjs"
      }
    },
    "./vue": {
      "import": {
        "types": "./dist/vue.d.ts",
        "default": "./dist/vue.js"
      },
      "require": {
        "types": "./dist/vue.d.cts",
        "default": "./dist/vue.cjs"
      }
    },
    "./element": {
      "import": {
        "types": "./dist/element.d.ts",
        "default": "./dist/element.js"
      }
    },
    "./node": {
      "import": {
        "types": "./dist/node.d.ts",
        "default": "./dist/node.js"
      },
      "require": {
        "types": "./dist/node.d.cts",
        "default": "./dist/node.cjs"
      }
    },
    "./browser": {
      "import": {
        "types": "./dist/browser.d.ts",
        "default": "./dist/browser.js"
      },
      "require": {
        "types": "./dist/browser.d.cts",
        "default": "./dist/browser.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite playground --port 5173 --open=false",
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "gallery": "tsup && node scripts/gallery.mjs",
    "build:angular": "tsup && npm --prefix angular run build",
    "prepublishOnly": "npm run build",
    "test": "tsup && node --test"
  },
  "peerDependencies": {
    "react": ">=17",
    "vue": ">=3",
    "@resvg/resvg-js": ">=2"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "vue": {
      "optional": true
    },
    "@resvg/resvg-js": {
      "optional": true
    }
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.0",
    "react": "^18.3.1",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vue": "^3.5.0"
  },
  "keywords": [
    "identicon",
    "avatar",
    "svg",
    "landscape",
    "jdenticon",
    "react",
    "vue",
    "angular"
  ],
  "license": "MIT",
  "author": "Victor",
  "homepage": "https://github.com/Victor-Go/Vicon#readme",
  "bugs": {
    "url": "https://github.com/Victor-Go/Vicon/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Victor-Go/Vicon.git"
  },
  "bin": {
    "vicon-avatars": "dist/cli.js"
  },
  "engines": {
    "node": ">=16"
  }
}
